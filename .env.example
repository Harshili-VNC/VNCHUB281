# Copy this file to .env and adjust if needed, then:
#   docker compose up -d
#   npm run db:push
#   npm run db:seed
#   npm run dev

# Matches docker-compose.yml's default credentials.
# Note: mapped to host port 55432 (an unusual port) specifically to avoid
# colliding with any Postgres instance you may already have running locally.
DATABASE_URL=postgres://postgres:Password@localhost:5432/vnc_hub

# Used to encrypt & sign the session cookie. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=8bfc54c0d4e22191f09991ee99a8c2927aa8ea0262365d132172ee193aae2738